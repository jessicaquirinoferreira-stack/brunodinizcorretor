rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jonasweb2rj@gmail.com' ||
        request.auth.token.email == 'brunodinizcorretordeimoveis@gmail.com' ||
        request.auth.uid == '1rIIihBz4yZhUBbaEDfJXqqQ7x43' ||
        request.auth.uid == 'SfjxdjTlcBeB5DmKvAo7AvfKCw03' ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || (data[key] is number);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || (data[key] is bool);
    }

    function isStringList(listVal, maxItems) {
      return listVal is list && listVal.size() <= maxItems && (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['brandName', 'tagline', 'creci', 'whatsappNumber']) &&
        data.keys().hasOnly([
          'brandName', 'tagline', 'creci', 'whatsappNumber', 'instagramHandle',
          'logoUrl', 'primaryColor', 'accentColor', 'backgroundColor',
          'displayFont', 'bodyFont', 'heroTitle', 'heroSubtitle', 'heroImage',
          'seoTitle', 'seoDescription', 'ga4Id', 'gtmId',
          'searchConsoleVerification', 'googleAdsId', 'lgpdNotice', 'updatedAt'
        ]) &&
        data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 120 &&
        data.tagline is string && data.tagline.size() > 0 && data.tagline.size() <= 200 &&
        data.creci is string && data.creci.size() > 0 && data.creci.size() <= 60 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 8 && data.whatsappNumber.size() <= 30 &&
        isOptionalString(data, 'instagramHandle', 80) &&
        isOptionalString(data, 'logoUrl', 1000) &&
        isOptionalString(data, 'primaryColor', 20) &&
        isOptionalString(data, 'accentColor', 20) &&
        isOptionalString(data, 'backgroundColor', 20) &&
        isOptionalString(data, 'displayFont', 80) &&
        isOptionalString(data, 'bodyFont', 80) &&
        isOptionalString(data, 'heroTitle', 180) &&
        isOptionalString(data, 'heroSubtitle', 400) &&
        isOptionalString(data, 'heroImage', 1000) &&
        isOptionalString(data, 'seoTitle', 120) &&
        isOptionalString(data, 'seoDescription', 320) &&
        isOptionalString(data, 'ga4Id', 60) &&
        isOptionalString(data, 'gtmId', 60) &&
        isOptionalString(data, 'searchConsoleVerification', 120) &&
        isOptionalString(data, 'googleAdsId', 60) &&
        isOptionalString(data, 'lgpdNotice', 1000);
    }

    function isValidProfessionalProfile(data) {
      return data.keys().hasAll(['name', 'creci', 'headline', 'bio']) &&
        data.keys().hasOnly([
          'name', 'creci', 'headline', 'bio', 'specialties', 'pillars',
          'instagramHandle', 'instagramPosts', 'instagramFollowers', 'instagramFollowing',
          'whatsapp', 'email', 'commercialAddress', 'experienceYears', 'portraitImage', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.creci is string && data.creci.size() > 0 && data.creci.size() <= 60 &&
        data.headline is string && data.headline.size() > 0 && data.headline.size() <= 220 &&
        data.bio is string && data.bio.size() > 0 && data.bio.size() <= 2500 &&
        (!('specialties' in data) || isStringList(data.specialties, 10)) &&
        (!('pillars' in data) || isStringList(data.pillars, 10)) &&
        isOptionalString(data, 'instagramHandle', 80) &&
        isOptionalNumber(data, 'instagramPosts') &&
        isOptionalNumber(data, 'instagramFollowers') &&
        isOptionalNumber(data, 'instagramFollowing') &&
        isOptionalString(data, 'whatsapp', 30) &&
        isOptionalString(data, 'email', 140) &&
        isOptionalString(data, 'commercialAddress', 260) &&
        isOptionalString(data, 'experienceYears', 80) &&
        isOptionalString(data, 'portraitImage', 1000);
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['code', 'slug', 'title', 'businessType', 'category', 'region', 'published', 'confirmationStatus']) &&
        data.keys().hasOnly([
          'code', 'slug', 'title', 'businessType', 'propertyType', 'category',
          'region', 'neighborhood', 'address', 'priceConfirmed', 'price',
          'condoFeeConfirmed', 'condoFee', 'areaConfirmed', 'areaSqm',
          'bedroomsConfirmed', 'bedrooms', 'suites', 'parkingSpots',
          'description', 'features', 'coverImage', 'gallery',
          'featured', 'published', 'confirmationStatus', 'confirmationNotes',
          'empreendimentoId', 'createdAt', 'updatedAt'
        ]) &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 40 && data.code.matches('^[a-zA-Z0-9_-]+$') &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9-]+$') &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
        data.businessType in ['Venda', 'Locação', 'Temporada', 'A confirmar'] &&
        (!('propertyType' in data) || data.propertyType in ['Apartamento', 'Casa', 'Cobertura', 'Flat', 'Terreno', 'A confirmar']) &&
        data.category in ['Litoral', 'Médio Padrão', 'Alto Padrão'] &&
        data.region is string && data.region.size() > 0 && data.region.size() <= 120 &&
        isOptionalString(data, 'neighborhood', 120) &&
        isOptionalString(data, 'address', 240) &&
        isOptionalBool(data, 'priceConfirmed') &&
        isOptionalNumber(data, 'price') &&
        isOptionalBool(data, 'condoFeeConfirmed') &&
        isOptionalNumber(data, 'condoFee') &&
        isOptionalBool(data, 'areaConfirmed') &&
        isOptionalNumber(data, 'areaSqm') &&
        isOptionalBool(data, 'bedroomsConfirmed') &&
        isOptionalNumber(data, 'bedrooms') &&
        isOptionalNumber(data, 'suites') &&
        isOptionalNumber(data, 'parkingSpots') &&
        isOptionalString(data, 'description', 4000) &&
        (!('features' in data) || isStringList(data.features, 20)) &&
        isOptionalString(data, 'coverImage', 1000) &&
        (!('gallery' in data) || isStringList(data.gallery, 100)) &&
        isOptionalBool(data, 'featured') &&
        data.published is bool &&
        data.confirmationStatus in ['a_confirmar', 'confirmado'] &&
        isOptionalString(data, 'confirmationNotes', 500) &&
        isOptionalString(data, 'empreendimentoId', 128);
    }

    function isValidEmpreendimento(data) {
      return data.keys().hasAll(['code', 'slug', 'name', 'category', 'region', 'stage', 'published', 'confirmationStatus']) &&
        data.keys().hasOnly([
          'code', 'slug', 'name', 'developer', 'category', 'region', 'stage',
          'priceFromConfirmed', 'priceFrom', 'areaRange', 'description',
          'amenities', 'coverImage', 'gallery', 'featured', 'published',
          'confirmationStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 40 && data.code.matches('^[a-zA-Z0-9_-]+$') &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9-]+$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 180 &&
        isOptionalString(data, 'developer', 140) &&
        data.category in ['Litoral', 'Médio Padrão', 'Alto Padrão'] &&
        data.region is string && data.region.size() > 0 && data.region.size() <= 120 &&
        data.stage in ['Lançamento', 'Em Construção', 'Pronto para Morar', 'A confirmar'] &&
        isOptionalBool(data, 'priceFromConfirmed') &&
        isOptionalNumber(data, 'priceFrom') &&
        isOptionalString(data, 'areaRange', 80) &&
        isOptionalString(data, 'description', 4000) &&
        (!('amenities' in data) || isStringList(data.amenities, 20)) &&
        isOptionalString(data, 'coverImage', 1000) &&
        (!('gallery' in data) || isStringList(data.gallery, 100)) &&
        isOptionalBool(data, 'featured') &&
        data.published is bool &&
        data.confirmationStatus in ['a_confirmar', 'confirmado'];
    }

    function isValidLandingPage(data) {
      return data.keys().hasAll(['slug', 'title', 'heroHeadline', 'targetType', 'published']) &&
        data.keys().hasOnly([
          'slug', 'title', 'kicker', 'heroHeadline', 'heroSubheadline', 'heroImage',
          'targetType', 'targetId', 'highlights', 'gallery', 'ctaLabel',
          'whatsappMessage', 'seoTitle', 'seoDescription', 'published', 'createdAt', 'updatedAt'
        ]) &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9-]+$') &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
        isOptionalString(data, 'kicker', 100) &&
        data.heroHeadline is string && data.heroHeadline.size() > 0 && data.heroHeadline.size() <= 200 &&
        isOptionalString(data, 'heroSubheadline', 450) &&
        isOptionalString(data, 'heroImage', 1000) &&
        data.targetType in ['property', 'empreendimento', 'campanha'] &&
        isOptionalString(data, 'targetId', 128) &&
        (!('highlights' in data) || isStringList(data.highlights, 12)) &&
        (!('gallery' in data) || isStringList(data.gallery, 100)) &&
        isOptionalString(data, 'ctaLabel', 80) &&
        isOptionalString(data, 'whatsappMessage', 300) &&
        isOptionalString(data, 'seoTitle', 120) &&
        isOptionalString(data, 'seoDescription', 320) &&
        data.published is bool;
    }

    function isValidLeadBase(data) {
      return data.keys().hasAll(['name', 'phone', 'source', 'score', 'status', 'lgpdConsent']) &&
        data.keys().hasOnly([
          'name', 'phone', 'email', 'message', 'source', 'propertyId',
          'propertyTitle', 'empreendimentoId', 'landingPageId', 'utmSource',
          'utmMedium', 'utmCampaign', 'score', 'scorePoints', 'status',
          'tags', 'lgpdConsent', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 40 &&
        isOptionalString(data, 'email', 160) &&
        isOptionalString(data, 'message', 2000) &&
        data.source is string && data.source.size() > 0 && data.source.size() <= 80 &&
        isOptionalString(data, 'propertyId', 128) &&
        isOptionalString(data, 'propertyTitle', 180) &&
        isOptionalString(data, 'empreendimentoId', 128) &&
        isOptionalString(data, 'landingPageId', 128) &&
        isOptionalString(data, 'utmSource', 100) &&
        isOptionalString(data, 'utmMedium', 100) &&
        isOptionalString(data, 'utmCampaign', 100) &&
        data.score in ['quente', 'morno', 'frio'] &&
        isOptionalNumber(data, 'scorePoints') &&
        data.status in ['novo_lead', 'contato', 'qualificado', 'visita_agendada', 'visita_realizada', 'proposta', 'negociacao', 'fechado', 'perdido'] &&
        (!('tags' in data) || isStringList(data.tags, 10)) &&
        data.lgpdConsent is bool && data.lgpdConsent == true;
    }

    function isValidLeadCreate(data) {
      return isValidLeadBase(data) && data.status == 'novo_lead';
    }

    function isValidLeadUpdate(data) {
      return isValidLeadBase(data);
    }

    function isValidClient(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.keys().hasOnly([
          'name', 'phone', 'email', 'origin', 'budgetRange',
          'preferredCategories', 'interestedPropertyIds', 'tags',
          'notes', 'leadId', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 40 &&
        isOptionalString(data, 'email', 160) &&
        isOptionalString(data, 'origin', 80) &&
        isOptionalString(data, 'budgetRange', 100) &&
        (!('preferredCategories' in data) || isStringList(data.preferredCategories, 10)) &&
        (!('interestedPropertyIds' in data) || isStringList(data.interestedPropertyIds, 20)) &&
        (!('tags' in data) || isStringList(data.tags, 15)) &&
        isOptionalString(data, 'notes', 3000) &&
        isOptionalString(data, 'leadId', 128);
    }

    function isValidInteraction(data) {
      return data.keys().hasAll(['type', 'summary']) &&
        data.keys().hasOnly(['type', 'summary', 'authorEmail', 'createdAt']) &&
        data.type in ['ligacao', 'whatsapp', 'email', 'visita', 'proposta', 'nota'] &&
        data.summary is string && data.summary.size() > 0 && data.summary.size() <= 1500 &&
        isOptionalString(data, 'authorEmail', 160);
    }

    function isValidPipelineDeal(data) {
      return data.keys().hasAll(['title', 'clientName', 'stage', 'score']) &&
        data.keys().hasOnly([
          'title', 'clientId', 'clientName', 'clientPhone', 'leadId',
          'propertyId', 'propertyTitle', 'stage', 'score', 'estimatedValue',
          'source', 'tags', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
        isOptionalString(data, 'clientId', 128) &&
        data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 140 &&
        isOptionalString(data, 'clientPhone', 40) &&
        isOptionalString(data, 'leadId', 128) &&
        isOptionalString(data, 'propertyId', 128) &&
        isOptionalString(data, 'propertyTitle', 180) &&
        data.stage in ['novo_lead', 'contato', 'qualificado', 'visita_agendada', 'visita_realizada', 'proposta', 'negociacao', 'fechado', 'perdido'] &&
        data.score in ['quente', 'morno', 'frio'] &&
        isOptionalNumber(data, 'estimatedValue') &&
        isOptionalString(data, 'source', 80) &&
        (!('tags' in data) || isStringList(data.tags, 10));
    }

    function isValidVisitBase(data) {
      return data.keys().hasAll(['clientName', 'clientPhone', 'scheduledDate', 'status']) &&
        data.keys().hasOnly([
          'clientName', 'clientPhone', 'clientEmail', 'propertyId',
          'propertyTitle', 'empreendimentoId', 'scheduledDate',
          'scheduledTime', 'notes', 'reminderSent', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 140 &&
        data.clientPhone is string && data.clientPhone.size() >= 6 && data.clientPhone.size() <= 40 &&
        isOptionalString(data, 'clientEmail', 160) &&
        isOptionalString(data, 'propertyId', 128) &&
        isOptionalString(data, 'propertyTitle', 180) &&
        isOptionalString(data, 'empreendimentoId', 128) &&
        data.scheduledDate is string && data.scheduledDate.size() > 0 && data.scheduledDate.size() <= 30 &&
        isOptionalString(data, 'scheduledTime', 20) &&
        isOptionalString(data, 'notes', 1000) &&
        isOptionalBool(data, 'reminderSent') &&
        data.status in ['solicitada', 'confirmada', 'realizada', 'cancelada'];
    }

    function isValidVisitCreate(data) {
      return isValidVisitBase(data) && data.status == 'solicitada';
    }

    function isValidVisitUpdate(data) {
      return isValidVisitBase(data);
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['clientName', 'propertyTitle', 'proposedValue', 'status']) &&
        data.keys().hasOnly([
          'clientId', 'clientName', 'propertyId', 'propertyTitle',
          'proposedValue', 'paymentTerms', 'documentUrl', 'documentName',
          'status', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isOptionalString(data, 'clientId', 128) &&
        data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 140 &&
        isOptionalString(data, 'propertyId', 128) &&
        data.propertyTitle is string && data.propertyTitle.size() > 0 && data.propertyTitle.size() <= 180 &&
        data.proposedValue is number &&
        isOptionalString(data, 'paymentTerms', 1500) &&
        isOptionalString(data, 'documentUrl', 1000) &&
        isOptionalString(data, 'documentName', 180) &&
        data.status in ['rascunho', 'enviada', 'em_analise', 'aceita', 'recusada'] &&
        isOptionalString(data, 'notes', 2000);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'priority', 'completed']) &&
        data.keys().hasOnly([
          'title', 'description', 'dueDate', 'priority', 'completed',
          'clientId', 'leadId', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
        isOptionalString(data, 'description', 1000) &&
        isOptionalString(data, 'dueDate', 40) &&
        data.priority in ['alta', 'media', 'baixa'] &&
        data.completed is bool &&
        isOptionalString(data, 'clientId', 128) &&
        isOptionalString(data, 'leadId', 128);
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['name', 'url', 'provider']) &&
        data.keys().hasOnly(['name', 'url', 'contentType', 'sizeBytes', 'provider', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.url is string && data.url.size() > 0 && data.url.size() <= 1000 &&
        isOptionalString(data, 'contentType', 100) &&
        isOptionalNumber(data, 'sizeBytes') &&
        data.provider in ['vercel_blob', 'local_asset', 'external'];
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['eventType', 'path']) &&
        data.keys().hasOnly(['eventType', 'path', 'targetId', 'source', 'utmSource', 'createdAt']) &&
        data.eventType in ['page_view', 'property_view', 'empreendimento_view', 'landing_view', 'whatsapp_click', 'lead_submit', 'visit_submit'] &&
        data.path is string && data.path.size() > 0 && data.path.size() <= 240 &&
        isOptionalString(data, 'targetId', 128) &&
        isOptionalString(data, 'source', 80) &&
        isOptionalString(data, 'utmSource', 100);
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
        data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt']) &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 160 &&
        isOptionalString(data, 'displayName', 140) &&
        data.role == 'admin';
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidSiteSettings(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /professionalProfile/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(profileId) && isValidProfessionalProfile(incoming());
      allow delete: if isAdmin() && isValidId(profileId);
    }

    match /properties/{propertyId} {
      allow get: if isValidId(propertyId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidId(propertyId) && isValidProperty(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(propertyId) && isValidProperty(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    match /empreendimentos/{empreendimentoId} {
      allow get: if isValidId(empreendimentoId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidId(empreendimentoId) && isValidEmpreendimento(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(empreendimentoId) && isValidEmpreendimento(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(empreendimentoId);
    }

    match /landingPages/{landingPageId} {
      allow get: if isValidId(landingPageId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidId(landingPageId) && isValidLandingPage(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(landingPageId) && isValidLandingPage(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(landingPageId);
    }

    match /leads/{leadId} {
      allow get: if isAdmin() && isValidId(leadId);
      allow list: if isAdmin();
      allow create: if isValidId(leadId) && isValidLeadCreate(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(leadId) && isValidLeadUpdate(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(leadId);
    }

    match /clients/{clientId} {
      allow get: if isAdmin() && isValidId(clientId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(clientId) && isValidClient(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(clientId) && isValidClient(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(clientId);

      match /interactions/{interactionId} {
        allow get: if isAdmin() && isValidId(clientId) && isValidId(interactionId);
        allow list: if isAdmin() && isValidId(clientId);
        allow create: if isAdmin() && isValidId(clientId) && isValidId(interactionId) && exists(/databases/$(database)/documents/clients/$(clientId)) && isValidInteraction(incoming()) && incoming().createdAt == request.time;
        allow delete: if isAdmin() && isValidId(clientId) && isValidId(interactionId);
      }
    }

    match /pipeline/{dealId} {
      allow get: if isAdmin() && isValidId(dealId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(dealId) && isValidPipelineDeal(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(dealId) && isValidPipelineDeal(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(dealId);
    }

    match /visits/{visitId} {
      allow get: if isAdmin() && isValidId(visitId);
      allow list: if isAdmin();
      allow create: if isValidId(visitId) && isValidVisitCreate(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(visitId) && isValidVisitUpdate(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(visitId);
    }

    match /proposals/{proposalId} {
      allow get: if isAdmin() && isValidId(proposalId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(proposalId) && isValidProposal(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(proposalId) && isValidProposal(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(proposalId);
    }

    match /tasks/{taskId} {
      allow get: if isAdmin() && isValidId(taskId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(taskId) && isValidTask(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(taskId) && isValidTask(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(taskId);
    }

    match /media/{mediaId} {
      allow get: if isAdmin() && isValidId(mediaId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(mediaId) && isValidMedia(incoming()) && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    match /analytics/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(eventId) && isValidAnalyticsEvent(incoming()) && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(eventId);
    }

    match /adminUsers/{uid} {
      allow get: if isAdmin() && isValidId(uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming());
      allow delete: if isAdmin() && isValidId(uid) && uid != request.auth.uid;
    }
  }
}
